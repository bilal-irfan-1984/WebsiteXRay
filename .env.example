# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAGESPEED_API_KEY: Optional Google PageSpeed Insights API key for higher rate limits.
# (If not provided, the public endpoint and server-side DOM crawler will operate seamlessly)
PAGESPEED_API_KEY=""

# ADMIN_SECRET: Secret for accessing the admin dashboard metrics and logs.
ADMIN_SECRET="xray-admin-secret"

# CLERK AUTHENTICATION CONFIGURATION
# Provide your Clerk Publishable Key from the Clerk Dashboard
VITE_CLERK_PUBLISHABLE_KEY=

