# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAGESPEED_API_KEY: Optional Google PageSpeed Insights API key for higher rate limits.
# (If not provided, the public endpoint and server-side DOM crawler will operate seamlessly)
PAGESPEED_API_KEY=""

# PADDLE_API_KEY: Paddle API access token (Bearer token) from Paddle Dashboard -> Developer tools -> Authentication
PADDLE_API_KEY=""

# PADDLE_CLIENT_TOKEN: Paddle Client-side Token for Paddle.js checkout
PADDLE_CLIENT_TOKEN=""

# PADDLE_WEBHOOK_SECRET_KEY: Secret key for verifying Paddle webhook signatures
PADDLE_WEBHOOK_SECRET_KEY=""

# PADDLE_ENVIRONMENT: "sandbox" or "production" (defaults to sandbox)
PADDLE_ENVIRONMENT="sandbox"

# ADMIN_SECRET: Secret for accessing the admin dashboard metrics and logs.
ADMIN_SECRET="xray-admin-secret"
